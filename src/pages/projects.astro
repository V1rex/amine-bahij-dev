---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
        title="Projects · Amine Bahij"
        description="Projects by Amine Bahij — backend systems, operations research, and applied optimization."
>
    <Navbar />

    <main>
        <section class="projects-hero">
            <div class="container">
                <p class="eyebrow">Projects</p>
                <h1>Systems, experiments, and applied optimization work.</h1>

                <p class="lead">
                    A curated selection of projects where I practice backend engineering,
                    software architecture, operations research, and decision-oriented systems.
                </p>
            </div>
        </section>

        <section class="section featured-section">
            <div class="container">
                <div class="section-header">
                    <div>
                        <p class="section-kicker">Featured</p>
                        <h2 class="section-title">Main project</h2>
                    </div>
                </div>

                <article class="featured-project card">
                    <div class="featured-copy">
                        <div>
                            <p class="project-label">Backend · Optimization · Logistics</p>
                            <h3>Lift Nexus API</h3>

                            <p>
                                A Spring Boot backend MVP for warehouse dispatch optimization.
                                The project explores how solver-based planning can be integrated
                                into APIs, persistence, asynchronous jobs, tests, documentation,
                                and CI-generated reports.
                            </p>
                        </div>

                        <div class="tag-list">
                            <span>Java</span>
                            <span>Spring Boot</span>
                            <span>PostgreSQL</span>
                            <span>Flyway</span>
                            <span>Timefold Solver</span>
                            <span>Docker</span>
                            <span>CI/CD</span>
                            <span>Testing</span>
                        </div>

                        <div class="project-actions">
                            <a href="https://lift-nexus.amine-bahij.dev/">Project site</a>
                            <a href="https://github.com/V1rex/lift-nexus-api">GitHub</a>
                        </div>
                    </div>

                    <div class="project-logo">
                        <img src="/images/logo-lift-nexus.png" alt="Lift Nexus API logo" />
                    </div>
                </article>
            </div>
        </section>
    </main>

    <Footer />
</BaseLayout>

<style>
    .projects-hero {
        padding: 5.5rem 0 3.5rem;
    }

    .eyebrow {
        margin: 0 0 1.25rem;
        color: var(--accent);
        font-size: 0.82rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    h1 {
        margin: 0;
        max-width: 900px;
        font-size: clamp(2.7rem, 6vw, 5.2rem);
        line-height: 0.98;
        letter-spacing: -0.07em;
    }

    .lead {
        margin: 1.5rem 0 0;
        max-width: 720px;
        color: var(--text-muted);
        font-size: clamp(1.2rem, 2.4vw, 1.55rem);
        line-height: 1.5;
        letter-spacing: -0.03em;
    }

    .featured-section {
        padding-top: 2rem;
    }

    .featured-project {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: 2.5rem;
        padding: 2rem;
    }

    .featured-copy {
        display: grid;
        gap: 1.5rem;
    }

    .project-label {
        margin: 0 0 0.75rem;
        color: var(--accent);
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    h3 {
        margin: 0;
        color: var(--text-main);
        font-size: clamp(1.45rem, 3vw, 2rem);
        letter-spacing: -0.045em;
    }

    .featured-copy p:not(.project-label) {
        margin: 0.85rem 0 0;
        max-width: 760px;
        color: var(--text-muted);
        line-height: 1.75;
    }

    .tag-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem;
    }

    .tag-list span {
        border: 1px solid var(--border);
        border-radius: 999px;
        background: var(--surface-muted);
        color: var(--text-muted);
        padding: 0.35rem 0.65rem;
        font-size: 0.78rem;
        font-weight: 650;
    }

    .project-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem;
    }

    .project-actions a {
        display: inline-flex;
        width: fit-content;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: var(--surface-muted);
        padding: 0.55rem 0.8rem;
        color: var(--text-main);
        font-size: 0.88rem;
        font-weight: 750;
    }

    .project-actions a:hover {
        border-color: rgba(37, 99, 235, 0.35);
        color: var(--accent);
    }

    .project-logo {
        display: grid;
        place-items: center;
        width: 160px;
        height: 160px;
        border: 1px solid var(--border);
        border-radius: 30px;
        background: var(--surface-muted);
    }

    .project-logo img {
        width: 116px;
        height: 116px;
        object-fit: contain;
    }

    @media (max-width: 820px) {
        .featured-project {
            grid-template-columns: 1fr;
        }

        .project-logo {
            order: -1;
            width: 96px;
            height: 96px;
            border-radius: 22px;
        }

        .project-logo img {
            width: 68px;
            height: 68px;
        }
    }
</style>