---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="Projects · Amine Bahij"
  description="Selected projects in backend engineering, software architecture, and operations research."
>
  <Navbar />

  <main>
    <section class="projects-hero">
      <div class="container">
        <p class="eyebrow">Projects</p>

        <h1>From backend systems to optimization software.</h1>

        <p class="lead">
          A selection of projects where I combine backend engineering,
          thoughtful software architecture, and operations research.
        </p>
      </div>
    </section>

    <section class="section project-group">
      <div class="container">
        <header class="group-header">
          <p class="group-kicker">
            Backend Engineering · Software Architecture
          </p>

          <h2>Building reliable systems around complex workflows.</h2>
        </header>

        <article class="project-card lift-card card">
          <div class="project-copy">
            <div>
              <p class="project-label">
                Backend System · Optimization · Logistics
              </p>

              <h3>Lift Nexus API</h3>

              <p class="project-description">
                A Spring Boot backend MVP for warehouse dispatch optimization.
                It integrates solver-based planning with APIs, persistence,
                asynchronous jobs, automated tests, documentation, and
                CI-generated reports.
              </p>
            </div>

            <div class="tag-list">
              <span>Java</span>
              <span>Spring Boot</span>
              <span>PostgreSQL</span>
              <span>Flyway</span>
              <span>Timefold Solver</span>
              <span>Docker</span>
              <span>Testing</span>
              <span>CI/CD</span>
            </div>

            <div class="project-actions">
              <a
                href="https://lift-nexus.amine-bahij.dev/"
                target="_blank"
                rel="noreferrer"
              >
                Project site
              </a>

              <a
                href="https://github.com/V1rex/lift-nexus-api"
                target="_blank"
                rel="noreferrer"
              >
                GitHub
              </a>
            </div>
          </div>

          <div class="project-logo">
            <img
              src="/images/logo-lift-nexus.png"
              alt="Lift Nexus API logo"
            />
          </div>
        </article>
      </div>
    </section>

    <section class="section project-group research-group">
      <div class="container">
        <header class="group-header">
          <p class="group-kicker">
            Operations Research · Software Architecture
          </p>

          <h2>Reusable foundations for mathematical optimization.</h2>
        </header>

        <article class="project-card bilevel-card card">
          <div class="project-copy">
            <div>
              <p class="project-label">
                Optimization Framework · Research Software
              </p>

              <h3>BilevelPy</h3>

              <p class="project-description">
                An extensible Python framework for building, solving, and
                evaluating Gurobi-based optimization models through reusable
                data, model, solver, and solution components.
              </p>
            </div>

            <div class="tag-list">
              <span>Python</span>
              <span>Gurobi</span>
              <span>Software Architecture</span>
              <span>Testing</span>
              <span>CI/CD</span>
              <span>Documentation</span>
            </div>

            <div class="project-actions">
              <a
                href="https://institute-of-transport-logistics.github.io/bilevelpy/"
                target="_blank"
                rel="noreferrer"
              >
                Documentation
              </a>

              <a
                href="https://github.com/Institute-of-Transport-Logistics/bilevelpy"
                target="_blank"
                rel="noreferrer"
              >
                GitHub
              </a>

              <a
                href="https://zenodo.org/records/21515530"
                target="_blank"
                rel="noreferrer"
              >
                Archived release
              </a>
            </div>

            <aside class="research-application">
              <p class="application-kicker">Applied in research</p>

              <h4>
                An Oracle-based Approach for Price-setting Problems in Logistics
              </h4>

              <p>
                BilevelPy provides the software foundation for the Python
                implementations and reproducible experiment workflow based on
                the paper.
              </p>

              <div class="application-links">
                <a
                  href="https://github.com/Institute-of-Transport-Logistics/oracle-price-settings-logistics"
                  target="_blank"
                  rel="noreferrer"
                >
                  View implementation →
                </a>

                <a
                  href="https://institute-of-transport-logistics.github.io/oracle-price-settings-logistics/"
                  target="_blank"
                  rel="noreferrer"
                >
                  View Documentation →
                </a>

                <a
                  href="https://zenodo.org/records/21522534"
                  target="_blank"
                  rel="noreferrer"
                >
                  View archive →
                </a>
              </div>
            </aside>
          </div>

          <div class="project-logo bilevel-logo">
            <img
              src="/images/bilevelpy_logo.png"
              alt="BilevelPy logo"
            />
          </div>
        </article>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .projects-hero {
    padding: 5.5rem 0 3.5rem;
  }

  .eyebrow,
  .group-kicker,
  .project-label,
  .application-kicker {
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .eyebrow {
    margin: 0 0 1.25rem;
  }

  h1 {
    max-width: 900px;
    margin: 0;
    font-size: clamp(2.7rem, 6vw, 5.2rem);
    line-height: 0.98;
    letter-spacing: -0.07em;
  }

  .lead {
    max-width: 720px;
    margin: 1.5rem 0 0;
    color: var(--text-muted);
    font-size: clamp(1.2rem, 2.4vw, 1.55rem);
    line-height: 1.5;
    letter-spacing: -0.03em;
  }

  .project-group {
    padding-top: 2rem;
  }

  .research-group {
    padding-top: 1rem;
  }

  .group-header {
    max-width: 760px;
    margin-bottom: 1.4rem;
  }

  .group-kicker {
    margin: 0 0 0.65rem;
  }

  .group-header h2 {
    margin: 0;
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    letter-spacing: -0.045em;
  }

  .project-card {
    --project-accent: var(--accent);

    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 170px;
    align-items: start;
    gap: 2.5rem;
    overflow: hidden;
    padding: 2rem;
  }

  .project-card::before {
    position: absolute;
    inset: 0 0 auto;
    height: 4px;
    background: var(--project-accent);
    content: "";
  }

  .project-copy {
    display: grid;
    gap: 1.5rem;
  }

  .project-label {
    margin: 0 0 0.75rem;
  }

  h3 {
    margin: 0;
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    letter-spacing: -0.045em;
  }

  .project-description {
    max-width: 760px;
    margin: 0.85rem 0 0;
    color: var(--text-muted);
    line-height: 1.75;
  }

  .tag-list,
  .project-actions,
  .application-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .tag-list span {
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface-muted);
    padding: 0.35rem 0.65rem;
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 650;
  }

  .project-actions a {
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface-muted);
    padding: 0.55rem 0.8rem;
    font-size: 0.88rem;
    font-weight: 750;
  }

  .project-actions a:hover {
    border-color: var(--project-accent);
    color: var(--project-accent);
  }

  .project-logo {
    display: grid;
    place-items: center;
    width: 160px;
    height: 160px;
    border: 1px solid var(--border);
    border-radius: 30px;
    background: var(--surface-muted);
  }

  .project-logo img {
    width: 116px;
    height: 116px;
    object-fit: contain;
  }

  .bilevel-card {
    --project-accent: #80c342;

    background:
      linear-gradient(
        135deg,
        rgba(128, 195, 66, 0.07),
        transparent 34%
      ),
      rgba(255, 255, 255, 0.92);
  }

  .bilevel-card .project-label,
  .bilevel-card .application-kicker {
    color: #568d25;
  }

  .bilevel-logo {
    border-color: rgba(128, 195, 66, 0.32);
    background: rgba(128, 195, 66, 0.08);
  }

  .research-application {
    border: 1px solid rgba(128, 195, 66, 0.32);
    border-left: 4px solid #80c342;
    border-radius: 14px;
    background: rgba(128, 195, 66, 0.07);
    padding: 1.25rem 1.35rem;
  }

  .application-kicker {
    margin: 0 0 0.55rem;
  }

  .research-application h4 {
    margin: 0;
    color: var(--text-main);
    font-size: 1.08rem;
    letter-spacing: -0.025em;
  }

  .research-application p:not(.application-kicker) {
    max-width: 700px;
    margin: 0.65rem 0 0;
    color: var(--text-muted);
    line-height: 1.65;
  }

  .application-links {
    margin-top: 0.85rem;
  }

  .application-links a {
    color: #568d25;
    font-size: 0.88rem;
    font-weight: 750;
  }

  .application-links a:hover {
    color: #365f16;
  }

  @media (max-width: 820px) {
    .project-card {
      grid-template-columns: 1fr;
      padding: 1.5rem;
    }

    .project-logo {
      order: -1;
      width: 96px;
      height: 96px;
      border-radius: 22px;
    }

    .project-logo img {
      width: 68px;
      height: 68px;
    }
  }
</style>